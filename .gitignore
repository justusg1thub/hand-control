#!/usr/bin/env python3
"""
Hand Control - Computer mit Handgesten steuern.

Funktionen:
- Maus steuern
- Klicks, Drag, Scrollen, Lautstärke
- globale Tastenkombinationen und Tray-Menü
- Vorschau mit Hilfe/Debug/Zone

Installation:
    pip install -r requirements.txt

Start:
    python hand_control.py
"""

